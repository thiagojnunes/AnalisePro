<Application x:Class="AnalisePro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dark modern brushes (Semânticos com suporte a Dark/Light Theme) -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0C10" />
        <SolidColorBrush x:Key="BgHeader" Color="#0E1017" />
        <SolidColorBrush x:Key="BgFooter" Color="#0C0D13" />
        <SolidColorBrush x:Key="BgCard" Color="#13151F" />
        <SolidColorBrush x:Key="BgCardHover" Color="#1B1E2E" />
        <SolidColorBrush x:Key="BgCardInner" Color="#161926" />
        <SolidColorBrush x:Key="BgCardDeep" Color="#10121C" />
        <SolidColorBrush x:Key="BgBadge" Color="#1E293B" />
        <SolidColorBrush x:Key="BgConsole" Color="#090A0F" />
        <SolidColorBrush x:Key="TabInactiveBg" Color="#141724" />
        <SolidColorBrush x:Key="BorderCard" Color="#222638" />
        <SolidColorBrush x:Key="BorderCardGlow" Color="#00F0FF" />

        <SolidColorBrush x:Key="InputBg" Color="#10121C" />
        <SolidColorBrush x:Key="InputFg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InputBorder" Color="#2A2F45" />

        <SolidColorBrush x:Key="AccentCyan" Color="#00F0FF" />
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676" />
        <SolidColorBrush x:Key="AccentPurple" Color="#A855F7" />
        <SolidColorBrush x:Key="AccentOrange" Color="#FFB703" />
        <SolidColorBrush x:Key="AccentRed" Color="#FF3366" />

        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />

        <!-- Clean modern ScrollBar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="#334155" CornerRadius="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ProgressBar -->
        <Style x:Key="ModernProgress" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#1E2235" />
            <Setter Property="Foreground" Value="{StaticResource AccentCyan}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid>
                            <Border Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
